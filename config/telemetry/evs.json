// EVS (Event Services) event messages. Source: cFE 6.7 cfe_evs_msg.h,
// cfe_msgids.h, cfe_mission_cfg.h.
//
// Telemetry definition files: one per app, listed under "telemetry" -> "catalog"
// in targets.json.
//   packets  one entry per telemetry MID the app sends
//   event    true for EVS event packets: shown in the event log. They must define
//            app_name, event_id and event_type, and may define message.
// Field types: u8 u16 u32 u64 i8 i16 i32 i64 f32 f64 string padding
//   size     required for string and padding (bytes on the wire)
//   enum     { "name": value, ... }  value shown by name
//   units    text shown after the value
//   hex      true: integer shown as 0x..
// Numbers may be written as JSON integers or as "0x.." strings.
// Fields are listed in payload order, after the 12-byte telemetry header
// (CFE_SB_TLM_HDR_SIZE: 6-byte primary header + 6-byte time). Multi-byte
// fields use the target byte order.
//
// Values taken from the FSW (update if the mission changes them):
//   cfe_msgids.h       CFE_EVS_LONG_EVENT_MSG_MID 0x0808, CFE_EVS_SHORT_EVENT_MSG_MID 0x0809
//   cfe_mission_cfg.h  CFE_MISSION_MAX_API_LEN 20, CFE_MISSION_EVS_MAX_MESSAGE_LENGTH 122
//   cfe_evs_extern_typedefs.h  CFE_EVS_EventType: DEBUG 1, INFORMATION 2, ERROR 3, CRITICAL 4
{
  "app": "evs",
  "help": "cFE Event Services",
  "packets": [
    {
      "name": "long_event",
      "mid": "0x0808",
      "event": true,
      "help": "Event message with text (CFE_EVS_LongEventTlm_t)",
      "fields": [
        { "name": "app_name", "type": "string", "size": 20 },
        { "name": "event_id", "type": "u16" },
        { "name": "event_type", "type": "u16",
          "enum": { "DEBUG": 1, "INFO": 2, "ERROR": 3, "CRIT": 4 } },
        { "name": "spacecraft_id", "type": "u32" },
        { "name": "processor_id", "type": "u32" },
        { "name": "message", "type": "string", "size": 122 },
        { "type": "padding", "size": 2 }
      ]
    },
    {
      "name": "short_event",
      "mid": "0x0809",
      "event": true,
      "help": "Event message without text, sent in short format mode (CFE_EVS_ShortEventTlm_t)",
      "fields": [
        { "name": "app_name", "type": "string", "size": 20 },
        { "name": "event_id", "type": "u16" },
        { "name": "event_type", "type": "u16",
          "enum": { "DEBUG": 1, "INFO": 2, "ERROR": 3, "CRIT": 4 } },
        { "name": "spacecraft_id", "type": "u32" },
        { "name": "processor_id", "type": "u32" }
      ]
    }
  ]
}
