// CI (Command Ingest) ground commands. Source: ci_msgids.h, ci_msgdefs.h, ci_app.c, ci_custom.c,
// ci_mission_cfg.h, ci_app.h.
//
// Field types: u8 u16 u32 u64 i8 i16 i32 i64 f32 f64 string padding
//   size     required for string and padding (bytes on the wire)
//   enum     { "name": value, ... }  names accepted as arguments, shown in help
//   min/max  inclusive range for integer fields
//   default  value used when the argument is omitted (only trailing arguments may be omitted)
// Numbers may be written as JSON integers or as "0x.." strings.
// Fields are listed in payload order, after the 8-byte command header.
// Commands are grouped by the MID they are sent on ("mids").
//
//   ci_msgids.h  CI_APP_CMD_MID 0x1934   CI_ProcessNewAppCmds, dispatched by command code
//                CI_SEND_HK_MID 0x1935   CI_ReportHousekeeping (length and code not checked)
//
// enable_to: CI_EnableTOCmd_t has the layout of TO_EnableOutputCmd_t
// (char cDestIp[TO_MAX_IP_STRING_SIZE = 16]; uint16 usDestPort) with ENABLE_CRYPTO_LIB
// off. With crypto on, append { "name": "key_id", "type": "u16" } (and a default for it).
//
// Handshake watchdog (ci_custom.c): enable_to also starts a timer that checks every 300 s that a
// handshake_signal came in since the last check; if none did, CI sends TO DISABLE_OUTPUT itself
// (telemetry stops) and deletes the timer. So after enable_to send handshake_signal at least
// every 5 minutes, or delete_handshake_wdg to keep the output on.
//
// Incoming message counter (ci_custom.c, ci_app.h CI_NUM_MAX_INCOMING_MSG 65000): CI counts every
// datagram it receives since boot (commands and CFDP PDUs of "file put"); at 65000 it reports
// "DoS Attack Detected" and stops receiving commands until the FSW restarts. Send
// reset_incoming_mess_counter well before that (it answers with no event).
//
// Not listed: none (CI_CUSTOM_EXAMPLE_CC and the gate commands are not built in).
{
  "app": "ci",
  "help": "Command Ingest application",
  "mids": [
    {
      "mid": "0x1934",
      "commands": [
        {
          "name": "noop",
          "cc": 0,
          "help": "No-op: increments the command counter and reports the CI version"
        },
        {
          "name": "reset",
          "cc": 1,
          "help": "Reset the command and command error counters"
        },
        {
          "name": "enable_to",
          "cc": 2,
          "help": "Enable telemetry output (forwarded to TO) to a destination IP and port",
          "fields": [
            { "name": "dest_ip", "type": "string", "size": 16, "default": "127.0.0.1",
              "help": "cDestIp" },
            { "name": "dest_port", "type": "u16", "default": 5011,
              "help": "usDestPort" }
          ]
        },
        {
          "name": "handshake_signal",
          "cc": 3,
          "help": "Pet the handshake watchdog that enable_to starts (send at least every 5 min, else CI stops telemetry)"
        },
        {
          "name": "reset_incoming_mess_counter",
          "cc": 5,
          "help": "Zero CI's received-message count (at 65000 since boot CI stops taking commands); no event"
        },
        {
          "name": "delete_handshake_wdg",
          "cc": 55,
          "help": "Stop the handshake watchdog: telemetry stays on without handshake_signal"
        }
      ]
    },
    {
      "mid": "0x1935",
      "commands": [
        {
          "name": "hk",
          "cc": 0,
          "help": "Request a housekeeping packet (normally sent by the scheduler)"
        }
      ]
    }
  ]
}
