// mcs target profiles. Comments (// and /* */) are allowed.
//
// Each target defines:
//   endian     byte order of the FSW CPU: "little" or "big"
//   catalog    command definition files, relative to this file
//   format     packet format plug-in   { "type": "ccsds_v1", ...options }
//   layers     optional wrapping layers, applied in order (e.g. CSP, later)
//   transport  transport plug-in        { "type": "udp", "host": ..., "port": ... }
//   telemetry  optional: where telemetry arrives and how to decode it (interactive session)
//              { "receiver": { "type": "udp", "port": ... }, "catalog": [ telemetry files ] }
//
// Built-in plug-ins and their options:
//   format    ccsds_v1   checksum: true|false (default true)
//   transport udp        host (default "127.0.0.1"), port (required)
//   transport dryrun     (no options) - print packets, send nothing
//   receiver  udp        host (default "0.0.0.0"), port (default 5011)
//
// Start the telemetry stream with e.g. "fsw to enable_output 127.0.0.1 5011".
//
// Select a target with --target NAME; list them with --list-targets.
{
  "default_target": "sil",

  "targets": {
    "sil": {
      "description": "cFS on this PC, ci_lab on UDP 1234",
      "endian": "little",
      "catalog": ["telecommand/ds.json", "telecommand/ci.json", "telecommand/fm.json", "telecommand/cf.json", "telecommand/cs.json", "telecommand/gpsr.json", "telecommand/pl.json", "telecommand/sch.json", "telecommand/lc.json", "telecommand/pbm.json", "telecommand/hs.json", "telecommand/to.json", "telecommand/aocs.json", "telecommand/sc.json", "telecommand/fdir.json", "telecommand/main.json"],
      "format":    { "type": "ccsds_v1" },
      "layers":    [],
      "transport": { "type": "udp", "host": "127.0.0.1", "port": 1234 },
      "telemetry": {
        "receiver": { "type": "udp", "port": 5011 },
        "catalog":  ["telemetry/es.json", "telemetry/evs.json", "telemetry/sb.json", "telemetry/tbl.json",
                     "telemetry/time.json", "telemetry/to.json", "telemetry/ci.json", "telemetry/sch.json",
                     "telemetry/sc.json", "telemetry/hs.json", "telemetry/cf.json", "telemetry/fm.json",
                     "telemetry/ds.json", "telemetry/lc.json", "telemetry/aocs.json", "telemetry/main.json",
                     "telemetry/pl.json", "telemetry/fdir.json"]
      }
    },

    "sil-dry": {
      "description": "Same as sil, but nothing is sent",
      "endian": "little",
      "catalog": ["telecommand/ds.json", "telecommand/ci.json", "telecommand/fm.json", "telecommand/cf.json", "telecommand/cs.json", "telecommand/gpsr.json", "telecommand/pl.json", "telecommand/sch.json", "telecommand/lc.json", "telecommand/pbm.json", "telecommand/hs.json", "telecommand/to.json", "telecommand/aocs.json", "telecommand/sc.json", "telecommand/fdir.json", "telecommand/main.json"],
      "format":    { "type": "ccsds_v1" },
      "transport": { "type": "dryrun" },
      "telemetry": {
        "receiver": { "type": "udp", "port": 5011 },
        "catalog":  ["telemetry/es.json", "telemetry/evs.json", "telemetry/sb.json", "telemetry/tbl.json",
                     "telemetry/time.json", "telemetry/to.json", "telemetry/ci.json", "telemetry/sch.json",
                     "telemetry/sc.json", "telemetry/hs.json", "telemetry/cf.json", "telemetry/fm.json",
                     "telemetry/ds.json", "telemetry/lc.json", "telemetry/aocs.json", "telemetry/main.json",
                     "telemetry/pl.json", "telemetry/fdir.json"]
      }
    }

    // Example for later, once a "csp" layer plug-in exists:
    // "lab-csp": {
    //   "description": "Lab board, CSP over UDP",
    //   "endian": "little",
    //   "catalog": ["telecommand/ds.json", "telecommand/ci.json", "telecommand/fm.json", "telecommand/cf.json", "telecommand/cs.json", "telecommand/gpsr.json", "telecommand/pl.json", "telecommand/sch.json", "telecommand/lc.json", "telecommand/pbm.json", "telecommand/hs.json", "telecommand/to.json", "telecommand/aocs.json", "telecommand/sc.json", "telecommand/fdir.json", "telecommand/main.json"],
    //   "format":    { "type": "ccsds_v1" },
    //   "layers":    [ { "type": "csp", "src": 10, "dst": 1, "dport": 10, "crc32": true } ],
    //   "transport": { "type": "udp", "host": "192.168.1.50", "port": 9600 }
    // }
  }
}
