// mcs target profiles. Comments (// and /* */) are allowed.
//
// Each target defines:
//   endian     byte order of the FSW CPU: "little" or "big"
//   catalog    command definition files, relative to this file
//   format     packet format plug-in   { "type": "ccsds_v1", ...options }
//   layers     optional wrapping layers, applied in order (e.g. CSP, later)
//   transport  transport plug-in        { "type": "udp", "host": ..., "port": ... }
//   telemetry  optional: where telemetry arrives and how to decode it (interactive session)
//              { "receiver": { "type": "udp", "port": ... }, "catalog": [ telemetry files ] }
//   console    optional: where the FSW console text arrives (full-screen session, F1 pane, F3)
//              { "receiver": { "type": "udp", "port": ... } }   "port" is required
//              e.g. the BBB's UART forwarded as UDP by a serial-to-Ethernet bridge
//   cfdp       optional: file transfer with CF ("file put/get"); needs "telemetry".
//              Every key is optional; the defaults are CF 2.2.1 as built for the `fsw` target:
//                local_entity "0.23"   this ground entity      remote_entity "0.24"  CF
//                uplink_mid "0x192D"   PDUs sent as commands (CF_INCOMING_PDU_MID)
//                downlink_mid "0x092D" PDUs received as telemetry (CF_SPACE_TO_GND_PDU_MID)
//                chunk_size 512        file bytes per uplink PDU (CI's datagram buffer)
//                pdus_per_second 100   uplink pacing of file data (CF's pipe holds 40)
//                downlink_dir "downlink"  where received files go (relative to the current dir)
//                ack_timeout 10, ack_limit 2, nak_timeout 5, nak_limit 3 (class 2), inactivity_timeout 30
//                save_incomplete false  keep partial downlinks in <downlink_dir>/.part
//
// Built-in plug-ins and their options:
//   format    ccsds_v1   checksum: true|false (default true)
//   transport udp        host (default "127.0.0.1"), port (required)
//   transport dryrun     (no options) - print packets, send nothing
//   receiver  udp        host (default "0.0.0.0"), port (default 5011)
//
// Start the telemetry stream with e.g. "fsw to enable_output 127.0.0.1 5011".
//
// Select a target with --target NAME; list them with --list-targets.
{
  "default_target": "fsw",

  "targets": {
    "fsw": {
      "description": "cFS on this PC, ci_lab on UDP 1234",
      "endian": "little",
      "catalog": ["telecommand/ds.json", "telecommand/evs.json", "telecommand/ci.json", "telecommand/fm.json", "telecommand/cf.json", "telecommand/cs.json", "telecommand/gpsr.json", "telecommand/pl.json", "telecommand/sch.json", "telecommand/lc.json", "telecommand/pbm.json", "telecommand/hs.json", "telecommand/to.json", "telecommand/aocs.json", "telecommand/sc.json", "telecommand/fdir.json", "telecommand/main.json"],
      "format":    { "type": "ccsds_v1" },
      "layers":    [],
      "transport": { "type": "udp", "host": "127.0.0.1", "port": 1234 },
      "telemetry": {
        "receiver": { "type": "udp", "port": 5011 },
        "catalog":  ["telemetry/es.json", "telemetry/evs.json", "telemetry/sb.json", "telemetry/tbl.json",
                     "telemetry/time.json", "telemetry/to.json", "telemetry/ci.json", "telemetry/sch.json",
                     "telemetry/sc.json", "telemetry/hs.json", "telemetry/cf.json", "telemetry/fm.json",
                     "telemetry/ds.json", "telemetry/lc.json", "telemetry/aocs.json", "telemetry/main.json",
                     "telemetry/pl.json", "telemetry/fdir.json"]
      },
      "console": {
        "receiver": { "type": "udp", "port": 8898 }    // FSW console text (bench UART bridge)
      },
      "cfdp": {
        "local_entity": "0.23", "remote_entity": "0.24",
        "uplink_mid": "0x192D", "downlink_mid": "0x092D",
        "chunk_size": 512, "pdus_per_second": 100, "downlink_dir": "downlink"
      }
    },

    "fsw-dry": {
      "description": "Same as fsw, but nothing is sent",
      "endian": "little",
      "catalog": ["telecommand/ds.json", "telecommand/evs.json", "telecommand/ci.json", "telecommand/fm.json", "telecommand/cf.json", "telecommand/cs.json", "telecommand/gpsr.json", "telecommand/pl.json", "telecommand/sch.json", "telecommand/lc.json", "telecommand/pbm.json", "telecommand/hs.json", "telecommand/to.json", "telecommand/aocs.json", "telecommand/sc.json", "telecommand/fdir.json", "telecommand/main.json"],
      "format":    { "type": "ccsds_v1" },
      "transport": { "type": "dryrun" },
      "telemetry": {
        "receiver": { "type": "udp", "port": 5011 },
        "catalog":  ["telemetry/es.json", "telemetry/evs.json", "telemetry/sb.json", "telemetry/tbl.json",
                     "telemetry/time.json", "telemetry/to.json", "telemetry/ci.json", "telemetry/sch.json",
                     "telemetry/sc.json", "telemetry/hs.json", "telemetry/cf.json", "telemetry/fm.json",
                     "telemetry/ds.json", "telemetry/lc.json", "telemetry/aocs.json", "telemetry/main.json",
                     "telemetry/pl.json", "telemetry/fdir.json"]
      },
      "cfdp": {
        "local_entity": "0.23", "remote_entity": "0.24",
        "uplink_mid": "0x192D", "downlink_mid": "0x092D",
        "chunk_size": 512, "pdus_per_second": 100, "downlink_dir": "downlink"
      }
    }

    // Second target: the lab satellite. Uncomment (and add a comma after "fsw-dry"),
    // then fill in the real values. Same apps on the board -> same catalogs as "fsw";
    // what usually differs is endian, transport (board IP), layers and CFDP pacing.
    // "lab-sat": {
    //   "description": "Lab satellite (RTEMS on the BBB), CI over UDP",
    //   "endian": "little",                            // BBB (ARM) is little-endian; "big" for e.g. PowerPC
    //   "catalog": ["telecommand/ds.json", "telecommand/evs.json", "telecommand/ci.json", "telecommand/fm.json", "telecommand/cf.json", "telecommand/cs.json", "telecommand/gpsr.json", "telecommand/pl.json", "telecommand/sch.json", "telecommand/lc.json", "telecommand/pbm.json", "telecommand/hs.json", "telecommand/to.json", "telecommand/aocs.json", "telecommand/sc.json", "telecommand/fdir.json", "telecommand/main.json"],
    //   "format":    { "type": "ccsds_v1" },
    //   "layers":    [],                               // e.g. [ { "type": "csp", "src": 10, "dst": 1, "dport": 10, "crc32": true } ] once a CSP layer exists
    //   "transport": { "type": "udp", "host": "192.168.1.50", "port": 1234 },  // board IP, CI port
    //   "telemetry": {
    //     "receiver": { "type": "udp", "port": 5011 },   // then: fsw to enable_output <this PC's IP> 5011
    //     "catalog":  ["telemetry/es.json", "telemetry/evs.json", "telemetry/sb.json", "telemetry/tbl.json",
    //                  "telemetry/time.json", "telemetry/to.json", "telemetry/ci.json", "telemetry/sch.json",
    //                  "telemetry/sc.json", "telemetry/hs.json", "telemetry/cf.json", "telemetry/fm.json",
    //                  "telemetry/ds.json", "telemetry/lc.json", "telemetry/aocs.json", "telemetry/main.json",
    //                  "telemetry/pl.json", "telemetry/fdir.json"]   // check struct layouts on the board build
    //   },
    //   "console": {
    //     "receiver": { "type": "udp", "port": 8898 }   // where the UART bridge sends the console
    //   },
    //   "cfdp": {
    //     "local_entity": "0.23", "remote_entity": "0.24",
    //     "uplink_mid": "0x192D", "downlink_mid": "0x092D",
    //     "chunk_size": 512, "pdus_per_second": 20,     // slower over a real link
    //     "downlink_dir": "downlink/lab-sat"
    //   }
    // }
  }
}
