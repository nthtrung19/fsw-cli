# Operational smoke test of every app the FSW runs: each one answers its NOOP with an event and
# its housekeeping request with a telemetry packet. Repeatable, changes nothing.
#
#   ./build/src/mcs -f scripts/apps_smoke.mcs            run (FSW up: cd ~/SDE/fsw && sudo ./run_fsw.sh)
#   ./build/src/mcs --check -f scripts/apps_smoke.mcs    check only, nothing sent
#   mcs> run scripts/apps_smoke.mcs                      from the full-screen session
#
# Apps: the cFE services and the apps of ntpm_defs/ntpm_cfe_es_startup.scr, in that order. Every
# NOOP answer is an INFO event (text: part of the message, case-insensitive). Not covered:
# - CS and GPSR: in mcs, but not started by the startup script (their commands get no answer);
# - TCS: started, but mcs has no catalog for it;
# - PBM's housekeeping (0x08E0, "fsw pbm app_hk"): no telemetry definition in mcs.
# The full per-app tests are the *_full.mcs scripts.

fsw to enable_output 127.0.0.1 5011
wait 2
timeout 5

test APP-ES "cFE ES answers" req APP-ALIVE
  fsw es noop
  expect-event CFE_ES id 3 type INFO text "no-op command"
  fsw es hk
  expect es.hk within 3
end

test APP-EVS "cFE EVS answers" req APP-ALIVE
  fsw evs noop
  expect-event CFE_EVS id 0 type INFO text "no-op command"
  fsw evs hk
  expect evs.hk within 3
end

test APP-SB "cFE SB answers" req APP-ALIVE
  fsw sb noop
  expect-event CFE_SB id 28 type INFO text "no-op cmd rcvd"
  fsw sb hk
  expect sb.hk within 3
end

